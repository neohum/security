{
  "enabled": true,
  "timezone": "Asia/Seoul",
  "schedule": "hourly",
  "workers": 3,
  "providerLanes": ["codex", "agy"],
  "autoConfigure": true,
  "github": {
    "autoBootstrap": true
  },
  "continuity": {
    "neverStop": true,
    "failoverOrder": ["codex", "agy", "gemini", "claude"],
    "modelFallbackEnv": "<PROVIDER>_FALLBACK_MODELS"
  },
  "marketIntervalHours": 24,
  "deployGate": "persona-or-human",
  "artifacts": {
    "provider": "r2",
    "prefix": "factory"
  },
  "notifications": {
    "provider": "resend"
  }
}

{
  "schema": 1,
  "required": ["test"],
  "conditional": [
    {
      "paths": ["src/ui/**", "app/**", "pages/**", "**/*.tsx", "**/*.jsx", "**/*.html", "**/*.vue"],
      "require": ["e2e", "visual", "responsive", "react-doctor"]
    },
    {
      "paths": ["bin/**", "scripts/**"],
      "require": ["cli-smoke"]
    },
    {
      "paths": ["scripts/security/**", "src/security/**", "src/auth/**", "src/crypto/**"],
      "require": ["security-triad"]
    },
    {
      "paths": [".mcp.json", ".agents/**", ".claude/**", ".cursor/mcp.json", ".codex/config.toml", "**/SKILL.md", "AGENTS.md", "CLAUDE.md"],
      "require": ["config-threat-scan"]
    }
  ],
  "commands": {
    "lint": "auto",
    "typecheck": "auto",
    "test": "auto",
    "e2e": "auto",
    "visual": "auto",
    "responsive": "node scripts/ops/verify-responsive.ts",
    "cli-smoke": "node scripts/route.ts \"health check\"",
    "react-doctor": "node scripts/loop/quality-profile.ts react-doctor",
    "security-triad": "node scripts/security/anti-reverse-engineering-gate.ts",
    "config-threat-scan": "node scripts/security/config-supply-chain-gate.ts"
  }
}
